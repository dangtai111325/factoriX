# Isolated FactoriX test/staging environment (NEVER point at production factorix-data / :8080 / pc03!)
FACTORIX_ENVIRONMENT=test
FACTORIX_ENABLE_DESTRUCTIVE_TESTS=YES_I_USE_EPHEMERAL_DB
POSTGRES_USER=factorix_test
POSTGRES_PASSWORD=factorix-test-ephemeral-pw
POSTGRES_DB=factorix_test
FACTORIX_DATABASE_URL=postgresql+asyncpg://factorix_test:factorix-test-ephemeral-pw@127.0.0.1:15432/factorix_test
FACTORIX_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
FACTORIX_BOOTSTRAP_TOKEN=test-bootstrap-token-do-not-use-in-prod
FACTORIX_WEB_ORIGIN=http://127.0.0.1:8081
FACTORIX_COOKIE_SECURE=false

# RabbitMQ (isolated test broker)
RABBITMQ_DEFAULT_USER=factorix_mq_test
RABBITMQ_DEFAULT_PASS=factorix-mq-test-pw
FACTORIX_RABBITMQ_URL=amqp://factorix_mq_test:factorix-mq-test-pw@127.0.0.1:15673/

# TDengine (isolated test TSDB via taosadapter WebSocket)
FACTORIX_TDENGINE_DSN=ws://root:taosdata@127.0.0.1:16041
FACTORIX_TDENGINE_DB=factorix_test_ts
FACTORIX_OPERATIONAL_HISTORY_DAYS=7

# Isolated OT Simulators (loopback / test compose net)
FACTORIX_OT_ALLOWLIST=127.0.0.1:15020,opc.tcp://127.0.0.1:14840,127.0.0.1:11883,http://127.0.0.1:18443,ws://127.0.0.1:18765,simulators:15020,opc.tcp://simulators:14840,simulators:11883,http://simulators:18443,ws://simulators:18765

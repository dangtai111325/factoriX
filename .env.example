# FactoriX Environment Configuration Template
# Copy this file to .env and configure values before starting the appliance.
# NEVER commit .env to source control!

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=factorix
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=factorix

# --- Application Environment ---
# Options: development, test, staging, production
FACTORIX_ENVIRONMENT=production

# SQLAlchemy database connection string
FACTORIX_DATABASE_URL=postgresql+asyncpg://factorix:change-me-to-a-secure-password@127.0.0.1:5432/factorix

# Secret encryption key for OT connector secrets (32 bytes base64-encoded or raw string)
FACTORIX_DATA_KEY=example-32-byte-base64-encryption-key=

# Token used for initial appliance bootstrapping / first admin setup
FACTORIX_BOOTSTRAP_TOKEN=example-secure-bootstrap-token

# Allowed web origin for CORS
FACTORIX_WEB_ORIGIN=http://127.0.0.1:8080

# Set to true in production if serving over HTTPS
FACTORIX_COOKIE_SECURE=false

# --- Collector & Messaging Runtime (edge | acquisition) ---
# Switch to 'acquisition' once RabbitMQ and TDengine are provisioned (S06-S16).
FACTORIX_COLLECTOR_MODE=edge
FACTORIX_ACQUISITION_DIR=/data/acquisition
FACTORIX_ACQUISITION_SPOOL_PATH=/data/acquisition/spool.sqlite
FACTORIX_ACQUISITION_SPOOL_MAX_BYTES=134217728

# --- RabbitMQ 4.0 Broker (use dedicated credentials, never guest/guest) ---
FACTORIX_RABBITMQ_USER=factorix_mq
FACTORIX_RABBITMQ_PASSWORD=change-me-to-a-secure-rabbitmq-password
FACTORIX_RABBITMQ_URL=amqp://factorix_mq:change-me-to-a-secure-rabbitmq-password@127.0.0.1:5672/
FACTORIX_RABBITMQ_MGMT_URL=http://127.0.0.1:15672
FACTORIX_RABBITMQ_PREFETCH=128
FACTORIX_RABBITMQ_PUBLISHER_MAX_INFLIGHT=64
FACTORIX_RABBITMQ_CONFIRM_TIMEOUT_S=10.0

# --- TDengine 3.3.6.13 Data Plane ---
FACTORIX_TDENGINE_DSN=ws://root:change-me-taos-password@127.0.0.1:6041
FACTORIX_TDENGINE_DB_PREFIX=fx_t_
FACTORIX_TDENGINE_DEFAULT_KEEP_DAYS=30
FACTORIX_TDENGINE_DEFAULT_CACHE_MB=16
FACTORIX_TDENGINE_POOL_SIZE=4
FACTORIX_OPERATIONAL_HISTORY_DAYS=7
FACTORIX_STORAGE_EXPORT_DIR=/data/exports

# --- Center Ingestion Worker ---
FACTORIX_INGESTION_BATCH_SIZE=256
FACTORIX_INGESTION_FLUSH_MS=100
FACTORIX_INGESTION_CONSUMER_CONCURRENCY=128
FACTORIX_INGESTION_SHADOW_PG=false

# --- Edge / Acquisition OT network allowlist (optional) ---
# Endpoints of configured connections (and commissioning tests) are allowed automatically.
# Use this only for EXTRA endpoints, comma separated, as host:port or URL.
FACTORIX_OT_ALLOWLIST=

# --- SMTP Alert Notification Configuration (Optional) ---
FACTORIX_SMTP_HOST=smtp.example.local
FACTORIX_SMTP_PORT=587
FACTORIX_SMTP_USER=alerts@example.local
FACTORIX_SMTP_PASSWORD=optional-smtp-password
FACTORIX_SMTP_FROM=FactoriX Alerts <alerts@example.local>

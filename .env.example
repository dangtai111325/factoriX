# FactoriX Environment Configuration Template
# Copy this file to .env and configure values before starting the appliance.
# NEVER commit .env to source control!

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=factorix
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=factorix

# --- Application Environment ---
# Options: development, test, staging, production
FACTORIX_ENVIRONMENT=production

# SQLAlchemy database connection string
FACTORIX_DATABASE_URL=postgresql+asyncpg://factorix:change-me-to-a-secure-password@127.0.0.1:5432/factorix

# Secret encryption key for OT connector secrets (32 bytes base64-encoded or raw string)
FACTORIX_DATA_KEY=example-32-byte-base64-encryption-key=

# Token used for initial appliance bootstrapping / first admin setup
FACTORIX_BOOTSTRAP_TOKEN=example-secure-bootstrap-token

# Allowed web origin for CORS
FACTORIX_WEB_ORIGIN=http://127.0.0.1:8080

# Set to true in production if serving over HTTPS
FACTORIX_COOKIE_SECURE=false

# --- Edge OT network allowlist (optional) ---
# The edge may only open sockets to OT endpoints. Endpoints of the connections configured in the
# console (and of commissioning tests) are allowed automatically; nothing has to be listed here.
# Use this only for EXTRA endpoints, comma separated, as host:port or URL, for example:
#   FACTORIX_OT_ALLOWLIST=10.0.0.20:502,opc.tcp://10.0.0.21:4840,ws://10.0.0.22/ws/live
# Default ports when a URL has none: http 80, https 443, ws 80, wss 443, opc.tcp 4840, mqtt 1883, modbus 502.
FACTORIX_OT_ALLOWLIST=

# --- SMTP Alert Notification Configuration (Optional) ---
FACTORIX_SMTP_HOST=smtp.example.local
FACTORIX_SMTP_PORT=587
FACTORIX_SMTP_USER=alerts@example.local
FACTORIX_SMTP_PASSWORD=optional-smtp-password
FACTORIX_SMTP_FROM=FactoriX Alerts <alerts@example.local>
